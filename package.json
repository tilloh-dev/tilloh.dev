{
  "name": "here",
  "version": "1.0.3",
  "license": "MIT",
  "scripts": {
    "postinstall": "cp git-hooks/* .git/hooks/ && chmod -R +x .git/hooks/",
    "dev": "concurrently \"pnpm dev-frontend\" \"pnpm dev-backend\"",
    "dev-frontend": "pnpm --filter ./frontend dev",
    "dev-backend": "pnpm --filter ./backend dev",
    "lint": "pnpm --filter ./frontend --filter ./backend run lint",
    "check": "pnpm --filter ./frontend run check",
    "test": "pnpm --filter ./backend run test",
    "build": "pnpm --filter ./frontend --filter ./backend run build",
    "e2e": "pnpm --filter ./e2e test",
    "e2e:headed": "pnpm --filter ./e2e test:headed",
    "e2e:ui": "pnpm --filter ./e2e test:ui",
    "e2e:install": "pnpm --filter ./e2e install-browsers",
    "e2e:install:ci": "pnpm --filter ./e2e install-browsers:ci",
    "e2e:setup": "cp e2e/.env.test.example e2e/.env.test && echo 'Copied .env.test.example to .env.test – fill in your values!'"
  },
  "private": true,
  "devDependencies": {
    "@nx/eslint": "20.8.2",
    "@nx/eslint-plugin": "^20.3.0",
    "@nx/js": "20.8.2",
    "@nx/linter": "^19.8.4",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.39.3",
    "npm": "^11.0.0",
    "nx": "20.8.2"
  },
  "packageManager": "pnpm@12.9.0"
}
